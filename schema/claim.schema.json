{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/star-nebula/SemanticMemory/schema/claim.schema.json",
  "title": "SemanticMemory Claim",
  "type": "object",
  "required": [
    "schema",
    "type",
    "id",
    "kind",
    "subject",
    "predicate",
    "status",
    "sources"
  ],
  "properties": {
    "schema": { "const": "semantic-memory/v1" },
    "type": { "const": "semantic-claim" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "title": { "type": "string" },
    "kind": {
      "enum": ["fact", "preference", "decision", "procedure", "constraint", "rule"]
    },
    "subject": { "type": "string", "minLength": 1 },
    "predicate": { "type": "string", "minLength": 1 },
    "object": { "type": "string" },
    "scope": { "type": "string" },
    "cardinality": { "enum": ["single", "multi"] },
    "status": {
      "enum": ["active", "superseded", "contested", "expired", "archived", "pending"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "human_review": {
      "enum": ["pending", "accepted", "disputed", "not_required"]
    },
    "review_policy": { "enum": ["auto", "agent", "human"] },
    "checked_at": { "type": "string" },
    "check_scope": { "type": "string" },
    "valid_from": { "type": "string" },
    "valid_to": { "type": ["string", "null"] },
    "observed_at": { "type": "string" },
    "updated": { "type": "string" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "null"] },
    "contradicts": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "reme_ref": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "quote"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "content_hash": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
